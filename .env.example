# Copy to .env.local for local development. Never commit real secrets.
# Only NEXT_PUBLIC_APP_URL may reach the browser. Everything else is server-only.

# ============================================================
# CLOUDNIVO
# ============================================================

CLOUDNIVO_URL=https://www.cloudnivo.org
CLOUDNIVO_API_URL=https://api.cloudnivo.org
CLOUDNIVO_PROJECT_ID=
CLOUDNIVO_PROJECT_URL=
CLOUDNIVO_PUBLIC_KEY=
CLOUDNIVO_SECRET_KEY=
CLOUDNIVO_AGENT_TOKEN=
CLOUDNIVO_DATABASE_URL=
CLOUDNIVO_STORAGE_URL=
CLOUDNIVO_BUCKET=business-data

# ============================================================
# APPLICATION
# ============================================================

APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# SECURITY (generate per environment; never commit real values)
# ============================================================

# Session cookie signing / CSRF tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Field-level encryption for provider credentials stored later. Generate separately from JWT_SECRET.
ENCRYPTION_KEY=

# ============================================================
# BACKEND OPTIONS
# ============================================================

# Uploads larger than this use object storage; smaller may inline to the
# database when storage is unreachable. Bytes.
MEDIA_INLINE_LIMIT=5242880
# Comma-separated origins allowed to call /api/* from browsers. Empty = same-origin only.
API_ALLOWED_ORIGINS=

# ============================================================
# GOOGLE GEMINI (server-only primary AI provider: text, intelligence, image, TTS)
# ============================================================

# Never commit a real key. Server-only: the SDK runs in route handlers/workers.
GEMINI_API_KEY=
# Optional model overrides (built-in defaults apply when unset):
# GEMINI_TEXT_MODEL=gemini-3.6-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore

# ============================================================
# YOUTUBE DATA API v3 (server-only; platform ingestion + research)
# ============================================================

# Google Cloud console API key with YouTube Data API v3 enabled.
# Server-only: all calls run in route handlers/workers. Never commit a real key.
YOUTUBE_API_KEY=
# Optional open-source fallback: base URL of an Invidious instance you trust
# (self-hosted recommended: https://github.com/iv-org/invidious).
# Used only when the Data API is unset or rejects a call. Empty = off.
# YOUTUBE_FALLBACK_BASE=https://your-invidious-host

# ============================================================
# DEFERRED INTEGRATIONS (leave empty until their phase)
# ============================================================

TEXT_PROVIDER=
TEXT_API_KEY=
IMAGE_PROVIDER=
IMAGE_API_KEY=
VIDEO_PROVIDER=
VIDEO_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=
MUSIC_PROVIDER=
MUSIC_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
RESEARCH_PROVIDER=
RESEARCH_API_KEY=
