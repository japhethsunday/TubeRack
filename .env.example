# Copy to .env.local for local development. Never commit real secrets.
# All AI provider keys are server-only (no NEXT_PUBLIC_ prefix) — see src/lib/env.ts.

APP_URL=http://localhost:3000

# AI providers (Phase 11 integration boundary — leave empty in Phase 1)
TEXT_PROVIDER=
TEXT_API_KEY=
IMAGE_PROVIDER=
IMAGE_API_KEY=
VIDEO_PROVIDER=
VIDEO_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=
MUSIC_PROVIDER=
MUSIC_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
RESEARCH_PROVIDER=
RESEARCH_API_KEY=

# YouTube (Phase 11 — server-only)
YOUTUBE_API_KEY=

# Self-hosted infra targets (Phase 11)
DATABASE_URL=
REDIS_URL=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
